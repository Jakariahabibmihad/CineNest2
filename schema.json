{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CineNest Anime Extension Catalog",
  "description": "Validation schema for CineNest internal anime extensions.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "catalogName": {
      "type": "string"
    },
    "catalogVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["website", "catalog_api", "direct_stream", "media_server"]
          },
          "baseUrl": { "type": "string", "format": "uri" },
          "websiteUrl": { "type": "string", "format": "uri" },
          "integrationType": {
            "type": "string",
            "enum": ["external", "documented_api", "direct_stream", "server_api", "internal_extension"]
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "search": { "type": "boolean" },
              "catalog": { "type": "boolean" },
              "playback": { "type": "boolean" }
            },
            "required": ["search", "catalog", "playback"],
            "additionalProperties": false
          },
          "authorization": {
            "type": "object",
            "properties": {
              "verified": { "type": "boolean" },
              "notes": { "type": "string" }
            },
            "required": ["verified"],
            "additionalProperties": false
          },
          "enabled": { "type": "boolean" }
        },
        "required": [
          "id",
          "name",
          "type",
          "baseUrl",
          "integrationType",
          "capabilities",
          "authorization",
          "enabled"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": ["schemaVersion", "catalogName", "catalogVersion", "updatedAt", "sources"],
  "additionalProperties": false
}
